# ============================================
# POSTGRESQL
# ============================================
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=chat_user
POSTGRES_PASSWORD=change_me
POSTGRES_DB=chat_app

# ============================================
# JWT АВТОРИЗАЦИЯ
# ============================================
JWT_SECRET=change_me_generate_random_string
JWT_EXPIRES_IN=7d

# ============================================
# BACKEND СЕРВЕР
# ============================================
NODE_ENV=production
PORT=8001
AI_ENABLED=true
AI_SERVICE_URL=http://ai-service:8002

# ============================================
# AI СЕРВИС (GigaChat)
# ============================================
GIGACHAT_AUTH_DATA=your_gigachat_auth_data
GIGACHAT_MODEL=Embeddings
GIGACHAT_CHAT_MODEL=GigaChat

# ============================================
# ПУТИ К ДАННЫМ
# ============================================
DB_PATH=/app/data/chat.db
AI_DB_PATH=/app/data/safety_checklist_db

# ============================================
# PROMPT ФАЙЛЫ
# ============================================
PROMPT_START_PATH=/app/prompts/prompt_start.txt
PROMPT_CONTINUE_PATH=/app/prompts/prompt_continue.txt